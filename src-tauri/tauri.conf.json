{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Calendaria",
  "version": "0.9.5",
  "identifier": "com.calendaria.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Calendaria",
        "width": 1100,
        "height": 750,
        "theme": "Dark",
        "backgroundColor": "#111214",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:calendaria.db"
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBRTcwNkU1RUFEOTI1M0QKUldROUpkbnE1UWJudXBWd2Zad1JrWEo4K2hLWG1rM25PYXlJZ29Qb2ZxUEwyRm53TXE3SGU3UFcK",
      "endpoints": [
        "https://github.com/bobtasticalbobo/Calendaria/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
