{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window on desktop",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    "notification:default",
    "updater:default",
    "process:allow-restart"
  ],
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ]
}
